FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests first for layer caching.
COPY package*.json ./
RUN npm ci --include=dev

# Copy source and configuration.
COPY tsconfig*.json ./
COPY jest.config*.js ./
COPY public ./public
COPY scripts/provision-css.mjs ./scripts/provision-css.mjs
COPY src ./src
COPY tests ./tests

# Build TypeScript.
RUN npm run build
